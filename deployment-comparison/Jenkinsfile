
pipeline {
    agent any

    stages {
        stage('Install Dependencies') {
            steps {
                dir('deployment-comparison') {
                    sh 'npm install'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                dir('deployment-comparison') {
                    sh 'nohup node server.js > app.log 2>&1 &'
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    for i in 1 2 3 4 5; do
                        if curl -fsS http://localhost:3000/health; then
                            exit 0
                        fi
                        sleep 2
                    done
                    exit 1
                '''
            }
        }
    }
}
